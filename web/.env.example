# Copy to .env.local for local use, or add these in Vercel > Project > Settings > Environment Variables.

# Google Maps Platform key with "Places API (New)" enabled. Without it the site runs in demo mode.
GOOGLE_PLACES_API_KEY=

# Anthropic API key (console.anthropic.com). Needed to read menus and check plates.
ANTHROPIC_API_KEY=

# The password friends type to get in. Leave empty to turn the gate off (fine on your own computer).
SITE_PASSWORD=

# Optional: most menu reads + plate checks per day before the site says "try tomorrow". Default 150.
MAX_CLAUDE_CALLS_PER_DAY=150
